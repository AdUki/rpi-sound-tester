From: Sound Tester <soundtester@localhost>
Subject: [PATCH] net: phy: realtek: clear RTL8211F wake-on-LAN state on init

The Khadas VIM3L keeps its RTL8211F powered through a reboot for wake-on-LAN, and a
vendor kernel's shutdown path arms magic-packet events, isolates the RGMII pads and
switches pin 31 to PMEB. A soft reset leaves all of it in place, so mainline sees no
carrier and receives nothing until the board is unplugged. Clear it in config_init.

Upstream-Status: Inappropriate [6.6 only; upstream now clears the PME events in rtl8211f_probe()]
---
--- a/drivers/net/phy/realtek.c	2026-09-25 12:41:28.246314088 +0200
+++ b/drivers/net/phy/realtek.c	2026-09-25 12:41:28.267628192 +0200
@@ -342,6 +342,43 @@
 			    CTL1000_ENABLE_MASTER | CTL1000_AS_MASTER);
 }
 
+#define RTL8211F_WOL_PAGE			0xd8a
+#define RTL8211F_WOL_EVENTS			0x10
+#define RTL8211F_WOL_RST_RMSQ			0x11
+#define RTL8211F_WOL_RG_RSTB			BIT(15)
+#define RTL8211F_WOL_PAD			0x13
+#define RTL8211F_WOL_PAD_ISOLATION		BIT(15)
+#define RTL8211F_INTBCR_PAGE			0xd40
+#define RTL8211F_INTBCR				0x16
+#define RTL8211F_INTBCR_PMEB			BIT(5)
+
+/* A PHY that stays powered through a reboot keeps its wake-on-LAN setup, and this driver has no
+ * WoL support to take it down again. A vendor kernel's shutdown path arms magic-packet events,
+ * isolates the RGMII pads and turns pin 31 from INTB into PMEB, and a soft reset clears none of
+ * it: the MAC then receives nothing and the link interrupt never fires. Undo all three.
+ */
+static int rtl8211f_clear_wol(struct phy_device *phydev)
+{
+	int ret;
+
+	ret = phy_write_paged(phydev, RTL8211F_WOL_PAGE, RTL8211F_WOL_EVENTS, 0);
+	if (ret < 0)
+		return ret;
+
+	ret = phy_modify_paged(phydev, RTL8211F_WOL_PAGE, RTL8211F_WOL_RST_RMSQ,
+			       RTL8211F_WOL_RG_RSTB, 0);
+	if (ret < 0)
+		return ret;
+
+	ret = phy_modify_paged(phydev, RTL8211F_WOL_PAGE, RTL8211F_WOL_PAD,
+			       RTL8211F_WOL_PAD_ISOLATION, 0);
+	if (ret < 0)
+		return ret;
+
+	return phy_modify_paged(phydev, RTL8211F_INTBCR_PAGE, RTL8211F_INTBCR,
+				RTL8211F_INTBCR_PMEB, 0);
+}
+
 static int rtl8211f_config_init(struct phy_device *phydev)
 {
 	struct rtl821x_priv *priv = phydev->priv;
@@ -349,6 +386,12 @@
 	u16 val_txdly, val_rxdly;
 	int ret;
 
+	ret = rtl8211f_clear_wol(phydev);
+	if (ret < 0) {
+		dev_err(dev, "clearing wake-on-LAN state failed: %pe\n", ERR_PTR(ret));
+		return ret;
+	}
+
 	ret = phy_modify_paged_changed(phydev, 0xa43, RTL8211F_PHYCR1,
 				       RTL8211F_ALDPS_PLL_OFF | RTL8211F_ALDPS_ENABLE | RTL8211F_ALDPS_XTAL_OFF,
 				       priv->phycr1);
