# Writes build_info.cpp (see src/build_info.h). Run with cmake -P at build time, not configure
# time, so the commit and time are the build's:
#   cmake -DSRC=<source dir> -DOUT=<file> [-DGIT=<override>] -P build_info.cmake
#
# In the Yocto recipe the source is a file:// copy with no .git of its own; git then finds the
# repository the build directory sits in, or nothing, and the version reads "unknown". -DGIT=
# (ST_VERSION_GIT) overrides it. string(TIMESTAMP) honours SOURCE_DATE_EPOCH, which a Yocto build
# sets for reproducibility (the newest source file's time).
if(NOT GIT)
  find_program(GIT_EXE git)
  if(GIT_EXE)
    execute_process(COMMAND ${GIT_EXE} -C ${SRC} describe --always --dirty --abbrev=12
                    OUTPUT_VARIABLE GIT OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      set(GIT "")
    endif()
  endif()
endif()
if(NOT GIT)
  set(GIT "unknown")
endif()
string(TIMESTAMP NOW "%Y-%m-%dT%H:%M:%SZ" UTC)
set(content "// Generated by cmake/build_info.cmake; do not edit.
#include \"build_info.h\"

namespace st {
const char* const kBuildGit = \"${GIT}\";
const char* const kBuildTime = \"${NOW}\";
}  // namespace st
")
file(WRITE ${OUT}.tmp "${content}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
file(REMOVE ${OUT}.tmp)
